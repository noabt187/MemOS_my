# Public HTTPS host. Use a domain name or a publicly reachable server IP.
PUBLIC_HOST=memory.example.com

# Used by Let's Encrypt for certificate expiry and account notices.
ACME_EMAIL=replace-with-your-email@example.com

# Use a new long random value. Do not reuse the example or the old local Neo4j password.
NEO4J_PASSWORD=replace-with-a-long-random-password

# Absolute path to the already-built MemOS_frontend/dist directory on this server.
# The frontend is static, so Compose does not build or run a frontend container.
MEMOS_FRONTEND_DIST=/absolute/path/to/MemOS_frontend/dist
