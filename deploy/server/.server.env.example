# Public HTTPS host for both the web page and /api/v1. Do not include https:// or a path.
PUBLIC_HOST=memos.example.com

# Used by Let's Encrypt for certificate expiry and account notices.
ACME_EMAIL=replace-with-your-email@example.com

# Use a new long random value. Do not reuse the example or the old local Neo4j password.
NEO4J_PASSWORD=replace-with-a-long-random-password

# Generate these values with scripts/memos_app_auth.py and keep them secret.
MEMOS_ACCESS_PASSWORD_HASH=replace-with-the-generated-password-hash
MEMOS_SESSION_SECRET=replace-with-at-least-32-random-characters

# Comma-separated exact origins allowed to call the API from a different website.
# Keep this empty for the integrated same-origin frontend.
MEMOS_CORS_ALLOWED_ORIGINS=

# Host ports published by Caddy. Change the HTTP port when port 80 is already occupied.
MEMOS_HTTP_PORT=80
MEMOS_HTTPS_PORT=443

# Optional Python package index used only while building the backend image.
PIP_INDEX_URL=https://pypi.org/simple
